<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
        android:text="Detalhes do Recibo" />

    <TextView
        android:id="@+id/tv_recibo_detalhes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        tools:text="Recibo: 123456" />

    <TextView
        android:id="@+id/tv_nome_cliente_detalhes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        tools:text="Cliente: João da Silva" />

    <TextView
        android:id="@+id/tv_cpf_cliente_detalhes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        tools:text="CPF: 123.456.789-00" />

    <TextView
        android:id="@+id/tv_placa_detalhes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        tools:text="Placa: ABC-1234" />

    <TextView
        android:id="@+id/tv_marca_modelo_detalhes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        tools:text="Veículo: Fiat Uno" />

    <TextView
        android:id="@+id/tv_cor_detalhes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        tools:text="Cor: Prata" />

    <TextView
        android:id="@+id/tv_data_entrada_detalhes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        tools:text="Entrada: 01/01/2024 10:00" />

    <TextView
        android:id="@+id/tv_data_saida_detalhes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        tools:text="Saída: 01/01/2024 12:00" />

    <TextView
        android:id="@+id/tv_tempo_permanencia_detalhes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        tools:text="Permanência: 2h 0m" />

    <TextView
        android:id="@+id/tv_desconto_detalhes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        tools:text="Desconto: R$ 5,00" />

    <TextView
        android:id="@+id/tv_valor_detalhes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
        tools:text="Valor Final: R$ 20,00" />

</LinearLayout>
