<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="cliente"
            type="com.example.parkmobile.data.model.Cliente" />
    </data>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="8dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- ID Label -->
            <TextView
                android:id="@+id/tv_id_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:text="ID: " />

            <!-- ID Value -->
            <TextView
                android:id="@+id/tv_id_cliente"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                app:layout_constraintStart_toEndOf="@id/tv_id_label"
                app:layout_constraintTop_toTopOf="@id/tv_id_label"
                app:layout_constraintBottom_toEndOf="@id/tv_id_label"
                android:text="@{cliente.id}"
                tools:text="1" />

            <!-- Nome -->
            <TextView
                android:id="@+id/tv_nome_cliente"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_id_label"
                android:text="@{cliente.nome}"
                tools:text="Nome Sobrenome" />

            <!-- CPF Label -->
            <TextView
                android:id="@+id/tv_cpf_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="CPF: "
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/tv_nome_cliente"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- CPF Value -->
            <TextView
                android:id="@+id/tv_cpf_cliente"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                app:layout_constraintStart_toEndOf="@id/tv_cpf_label"
                app:layout_constraintTop_toTopOf="@id/tv_cpf_label"
                app:layout_constraintBottom_toBottomOf="@id/tv_cpf_label"
                android:text="@{cliente.cpf}"
                tools:text="123.456.789-00" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>